# Copier vers .env (ignore par git) : cp .env.example .env
# Secret de signature JWT de l'auth-service : 32 octets minimum. Valeur de DEV uniquement.
JWT_SECRET=change-me-dev-only-0123456789-abcdefghij
# Compte administrateur cree au demarrage de l'auth-service (DEV uniquement).
DOP_ADMIN_EMAIL=admin@dop.local
DOP_ADMIN_PASSWORD=ChangeMe-Dev-2026!
# Rate limiting de la gateway (optionnel) : requetes/seconde par IP et rafale max.
# RATE_LIMIT_REPLENISH_RATE=10
# RATE_LIMIT_BURST_CAPACITY=20